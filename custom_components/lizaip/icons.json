{
  "entity": {
    "sensor": {
      "battery": {
        "default": "mdi:battery"
      },
      "ip_address": {
        "default": "mdi:ip-network"
      },
      "queue": {
        "default": "mdi:playlist-music"
      }
    },
    "number": {
      "brightness": {
        "default": "mdi:brightness-6"
      }
    },
    "event": {
      "button": {
        "default": "mdi:gesture-tap-button"
      }
    },
    "switch": {
      "brightness_automatic": {
        "default": "mdi:brightness-auto"
      }
    },
    "button": {
